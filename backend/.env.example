# ============================================================================
# DEWA AI Support Backend - Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in your values
# NEVER commit .env to git - it's already in .gitignore ✅
# ============================================================================

# ============================================================================
# Server Configuration
# ============================================================================
# PORT: Heroku/Cloud Run will set this automatically
# Leave empty to allow platform assignment or set to 3001 for local development
PORT=3001

# NODE_ENV: development | production
# Set to 'production' when deploying to live environment
NODE_ENV=development

# ============================================================================
# JWT Configuration - CHANGE THESE FOR PRODUCTION!
# ============================================================================
# Generate new secure keys for production using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# These are used to sign and verify JWT tokens for authentication
# If compromised, users can create fake tokens
#
# DEVELOPMENT (LOCAL TESTING - OK to keep these):
JWT_SECRET=dewa-hackathon-secret-key-2026
JWT_REFRESH_SECRET=dewa-hackathon-refresh-secret-2026

# PRODUCTION (GENERATE NEW):
# JWT_SECRET=<generate-a-secure-random-string-here>
# JWT_REFRESH_SECRET=<generate-another-secure-random-string-here>

# ============================================================================
# OpenAI Configuration - CRITICAL SECURITY ⚠️
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
#
# SECURITY RULES:
#   ✅ NEVER commit this to git
#   ✅ .env is in .gitignore - safe to use locally
#   ✅ Set in production platform's environment variable settings
#   ✅ NOT exposed to frontend code
#   ✅ NOT logged in error messages
#   ✅ Rotate key if compromised
#
# LOCAL TESTING (Development):
#   1. Get API key from https://platform.openai.com/api-keys
#   2. Copy full key (starts with sk-proj-)
#   3. Paste below or set as environment variable
#   4. Start backend - it will read from this .env file
#
# PRODUCTION (Netlify/Cloud Run/Heroku/etc):
#   1. DO NOT add key to this file
#   2. Log into your platform's dashboard
#   3. Go to Environment Variables / Secrets section
#   4. Add: OPENAI_API_KEY = sk-proj-your-actual-key
#   5. Deploy - platform passes it to backend at runtime
#   6. Backend automatically reads from process.env.OPENAI_API_KEY
#
OPENAI_API_KEY=sk-proj-your-key-here

# ============================================================================
# Frontend URL - CORS Configuration
# ============================================================================
# This controls which frontend domains can call your API
#
# DEVELOPMENT (Local):
#   FRONTEND_URL=http://localhost:5173
#   or
#   FRONTEND_URL=http://localhost:5174
#
# PRODUCTION (Netlify):
#   FRONTEND_URL=https://your-site-name.netlify.app
#   or if using custom domain:
#   FRONTEND_URL=https://your-custom-domain.com
#
# SECURITY NOTE: Only the exact URL in FRONTEND_URL can make API calls
# This prevents unauthorized frontend from accessing your API
#
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Email Configuration (Optional - for real MFA emails)
# ============================================================================
# For demo/testing: OTP codes print to console (no email needed)
# For production: Configure your email service
#
# Option 1: Gmail
# EMAIL_USER=noreply@dewa.gov.ae
# EMAIL_PASSWORD=your-app-specific-password

# Option 2: SendGrid (Recommended for production)
# SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Option 3: AWS SES
# AWS_SES_ACCESS_KEY=your-aws-access-key
# AWS_SES_SECRET_KEY=your-aws-secret-key
# AWS_SES_REGION=us-east-1

# ============================================================================
# Logging Configuration
# ============================================================================
# LOG_LEVEL controls how verbose logs are:
# - debug: Very detailed (use during development)
# - info: Normal (default)
# - warn: Only warnings and errors (use in production)
# - error: Only errors
#
LOG_LEVEL=info

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Prevents abuse by limiting requests per time window
#
RATE_LIMIT_WINDOW=15          # Time window in minutes
RATE_LIMIT_MAX_REQUESTS=50    # Max requests per window per IP

# ============================================================================
# MFA/OTP Configuration
# ============================================================================
# OTP (One-Time Password) used for two-factor authentication
#
OTP_EXPIRY_MINUTES=5          # How long OTP is valid
OTP_MAX_ATTEMPTS=3            # Max failed attempts before lockout
