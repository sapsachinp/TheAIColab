# ============================================================================
# DEWA AI Support Frontend - Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env (or .env.local) and fill in your values
# This .env file is in .gitignore - secrets will NOT be committed
# ============================================================================

# ============================================================================
# API Configuration - CRITICAL FOR PRODUCTION
# ============================================================================
# Points to your deployed backend API
#
# LOCAL DEVELOPMENT (Development):
#   VITE_API_URL=http://localhost:3001
#   (Leave empty to use mock data for testing without backend)
#
# PRODUCTION (Netlify):
#   Set this in Netlify Dashboard → Settings → Build & Deploy → Environment
#   Key: VITE_API_URL
#   Value: https://your-backend-domain.com
#   
#   Examples:
#   - Google Cloud Run: https://dewa-ai-backend-xyz.run.app
#   - Heroku: https://your-app-name.herokuapp.com
#   - Railway: https://your-project-railway.app
#   - AWS: https://your-api.execute-api.region.amazonaws.com
#
# NOTE: Frontend will use mock data if VITE_API_URL is not set
# This allows testing the UI without requiring backend
#
VITE_API_URL=http://localhost:3001

# ============================================================================
# Application Metadata (Optional)
# ============================================================================
# These are informational only - not required for functionality
#
VITE_APP_NAME=DEWA AI Support
VITE_APP_VERSION=1.0.0

# ============================================================================
# Logging Level (optional)
# ============================================================================
# Set to "warn" or "error" in production to reduce console logs
# In development, can be "debug" or "info" for more detailed logs
#
# VITE_LOG_LEVEL=info
